
# 🧪 DEVELOPMENT ENVIRONMENT
DEPLOYMENT_ENV=development
ENV_TIER=dev

# Core Configuration
ODOO_NAMESPACE=odoo-18-dev
APP_NAME=odoo-18-dev-app
SERVICE_NAME=odoo-18-dev-service

# Images - Development versions
IMAGE_TAG=bookworm-18.0-dev
SUPERVISOR_TAG=supervisor-18.0-dev

# Resources - Development scale
CPU_LIMIT=2000m
MEMORY_LIMIT=4Gi
CPU_REQUEST=1000m
MEMORY_REQUEST=4Gi
APP_REPLICAS=1

# Storage - Small development volumes
DATA_STORAGE_SIZE=5Gi
OPT_STORAGE_SIZE=2Gi
PYTHON3_STORAGE_SIZE=1Gi
EXTERNAL_STORAGE_SIZE=10Gi

# Database - Single instance
DB_STORAGE_SIZE=20Gi
DB_INSTANCES=1
DB_CPU_LIMIT=2000m
DB_MEMORY_LIMIT=8Gi

# Ingress - Development domain
ODOO_HOSTNAME=dev.odoo-shell.dev
CERT_ISSUER=letsencrypt-staging

# Debug settings
DEBUG_MODE=true
LOG_LEVEL=DEBUG
ENABLE_MONITORING=false