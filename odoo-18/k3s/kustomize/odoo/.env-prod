
# 🏭 PRODUCTION ENVIRONMENT
DEPLOYMENT_ENV=production
ENV_TIER=prod

# Core Configuration
ODOO_NAMESPACE=odoo-18
APP_NAME=odoo-18-app
SERVICE_NAME=odoo-18-service

# Images - Stable production versions
IMAGE_TAG=bookworm-18.0
SUPERVISOR_TAG=supervisor-18.0

# Resources - Production scale
CPU_LIMIT=8000m
MEMORY_LIMIT=8Gi
CPU_REQUEST=4000m
MEMORY_REQUEST=8Gi
APP_REPLICAS=3

# Storage - Production volumes
DATA_STORAGE_SIZE=100Gi
OPT_STORAGE_SIZE=20Gi
PYTHON3_STORAGE_SIZE=10Gi
EXTERNAL_STORAGE_SIZE=200Gi

# Database - High availability
DB_STORAGE_SIZE=500Gi
DB_INSTANCES=3
DB_CPU_LIMIT=8000m
DB_MEMORY_LIMIT=28Gi
DB_CPU_REQUEST=6000m
DB_MEMORY_REQUEST=22Gi

# PostgreSQL tuning
PG_SHARED_BUFFERS=2GB
PG_MAX_CONNECTIONS=500
PG_WORK_MEM=8MB

# Ingress - Production domain
ODOO_HOSTNAME=erp.odoo-shell.dev
CERT_ISSUER=letsencrypt-production
TLS_SECRET_NAME=erp-odoo-shell-dev-tls

# Production settings
DEBUG_MODE=false
LOG_LEVEL=WARN
ENABLE_MONITORING=true
ENABLE_BACKUP=true
ENABLE_SSL=true

# Backup configuration
BACKUP_BUCKET=s3://odoo-production/
BACKUP_ENDPOINT=https://eu2.contabostorage.com/

# Security
ENABLE_HPA=true
MIN_REPLICAS=2
MAX_REPLICAS=10